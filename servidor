#!/usr/bin/env python3
import asyncio
from tcp import Servidor
import re


usuarios = {} # Set para guardas os usuários conectados
canais = {} # Set para guardar os canais e seus membros

def validar_nome(nome):
    return re.match(br'^[a-zA-Z][a-zA-Z0-9_-]*$', nome) is not None


# Função para diminuir a chamada de conexao.nick.lower()
def chave(nome):
    return nome.lower()

# Função para diminuir a chamada de conexao.enviar(dados)
def enviar(conexao, dados):
    try:
        conexao.enviar(dados) # Para evitar erro ao 
        # tentar notificar um usuário que já desconectou
    except (BrokenPipeError, ConnectionResetError):
        pass

# Retorna um set com os usuarios em comum 
def usuarios_em_comum(conexao):
    resultado = set()

    for canal in conexao.canais:
        for usuario in canais.get(canal, set()):
            if usuario is not conexao:
                resultado.add(usuario)

    return resultado


def sair(conexao):
    print(conexao, 'conexão fechada')

    # So faz se ja era registrado
    if conexao.nick != b'*':
        # Envia mensagem pra todo mundo
        for usuario in usuarios_em_comum(conexao):
            enviar(
                usuario,
                b':' + conexao.nick + b' QUIT :Connection closed\r\n'
            )

        # Remove o usuario
        usuarios.pop(chave(conexao.nick), None)

        # Tira o membro dos canais que ele esta
        for canal in list(conexao.canais):
            membros = canais.get(canal)

            if membros is not None:
                membros.discard(conexao)

                if not membros:
                    canais.pop(canal, None)

        conexao.canais.clear()

    conexao.fechar()

# NICK apelido 
def processar_nick(conexao, partes):
    if len(partes) < 2:
        return

    novo_nick = partes[1]

    if not validar_nome(novo_nick):
        enviar(
            conexao,
            b':server 432 ' + conexao.nick + b' ' +
            novo_nick + b' :Erroneous nickname\r\n'
        )
        return

    nova_chave = chave(novo_nick)

    if nova_chave in usuarios and usuarios[nova_chave] is not conexao:
        enviar(
            conexao,
            b':server 433 ' + conexao.nick + b' ' +
            novo_nick + b' :Nickname is already in use\r\n'
        )
        return

    nick_antigo = conexao.nick

    if nick_antigo == novo_nick:
        return

    if nick_antigo != b'*':
        usuarios.pop(chave(nick_antigo), None)

        conexao.nick = novo_nick
        usuarios[nova_chave] = conexao

        mensagem = (
            b':' + nick_antigo +
            b' NICK ' + novo_nick + b'\r\n'
        )

        enviar(conexao, mensagem)

        for usuario in usuarios_em_comum(conexao):
            enviar(usuario, mensagem)

    else:
        conexao.nick = novo_nick
        usuarios[nova_chave] = conexao

        enviar(
            conexao,
            b':server 001 ' + novo_nick + b' :Welcome\r\n'
        )
        enviar(
            conexao,
            b':server 422 ' + novo_nick +
            b' :MOTD File is missing\r\n'
        )

# PING payload
def processar_ping(conexao, partes):
    if len(partes) >= 2:
        payload = partes[1]
        enviar(
            conexao,
            b':server PONG server :' + payload + b'\r\n'
        )

# PRIVMSG destinatario :mensagem
def processar_privmsg(conexao, partes):
    if len(partes) < 3:
        return

    destinatario = partes[1]
    conteudo = partes[2]

    mensagem = (
        b':' + conexao.nick +
        b' PRIVMSG ' + destinatario +
        b' ' + conteudo + b'\r\n'
    )

    # Se é pra um canal começa com #
    if destinatario.startswith(b'#'):
        # Pega os membros do canal
        canal = chave(destinatario)
        membros = canais.get(canal)

        # Ve se o canal existe ou se o usuario nao esta 
        # no canal
        if membros is None or conexao not in membros:
            return

        # Envia a mensagem para todo mundo menos para
        # o remetente
        for usuario in membros:
            if usuario is not conexao:
                enviar(usuario, mensagem)

    else:
        usuario = usuarios.get(chave(destinatario))

        # Se o usuário existe e não é uma mensagem pra ele mesmo
        if usuario is not None and usuario is not conexao:
            enviar(usuario, mensagem)

# JOIN canal
def processar_join(conexao, partes):
    if len(partes) < 2:
        return

    nome_canal = partes[1]

    # Valida o nome do canal
    if (
        not nome_canal.startswith(b'#') or
        not validar_nome(nome_canal[1:])
    ):
        enviar(
            conexao,
            b':server 403 ' + nome_canal +
            b' :No such channel\r\n'
        )
        return

    canal = chave(nome_canal)

    # Cria se nao estivar na lista
    if canal not in canais:
        canais[canal] = set()

    membros = canais[canal]

    # Se ja tiver nao faz nada
    if conexao in membros:
        return

    mensagem_join = (
        b':' + conexao.nick +
        b' JOIN :' + nome_canal + b'\r\n'
    )

    # Envia para avisar os membros do canal
    for usuario in membros:
        enviar(usuario, mensagem_join)

    # Atualiza os membros do canal
    membros.add(conexao)
    conexao.canais.add(canal)

    enviar(conexao, mensagem_join)

    # Lista de nomas ordenados para quem entrou
    nomes = sorted(
        [usuario.nick for usuario in membros],
        key=lambda nome: nome.lower()
    )

    prefixo = (
        b':server 353 ' + conexao.nick +
        b' = ' + nome_canal + b' :'
    )

    limite = 512 - 2
    atual = prefixo

    for nome in nomes:
        parte = nome if atual == prefixo else b' ' + nome

        if len(atual) + len(parte) > limite:
            enviar(conexao, atual + b'\r\n')
            atual = prefixo + nome
        else:
            atual += parte

    if atual != prefixo:
        enviar(conexao, atual + b'\r\n')

    enviar(
        conexao,
        b':server 366 ' + conexao.nick +
        b' ' + nome_canal +
        b' :End of /NAMES list.\r\n'
    )

# PART canal
def processar_part(conexao, partes):
    if len(partes) < 2:
        return

    # Pega o nome do canal e o objeto do canal
    nome_canal = partes[1]
    canal = chave(nome_canal)
    membros = canais.get(canal)

    # Se nao tem o canal ou o usuario nao esta no canal
    if membros is None or conexao not in membros:
        return

    # Mensagem se saida
    mensagem = (
        b':' + conexao.nick +
        b' PART ' + nome_canal + b'\r\n'
    )

    # Envia a mensagem pra todo mundo
    for usuario in list(membros):
        enviar(usuario, mensagem)

    # Tira quem saiu
    membros.remove(conexao)
    conexao.canais.discard(canal)

    # Se nao tem mais ninguem remove o canal
    if not membros:
        canais.pop(canal, None)


def processar_mensagem(conexao, dados):
    partes = dados.split(b' ', 2)

    if not partes:
        return

    comando = partes[0].upper()

    # OKKKK
    if comando == b'NICK':
        processar_nick(conexao, partes)
    
    # OKKKK
    elif comando == b'PING':
        processar_ping(conexao, partes)

    # OKKKK
    elif comando == b'PRIVMSG':
        processar_privmsg(conexao, partes)

    # OKKKK
    elif comando == b'JOIN':
        processar_join(conexao, partes)


    elif comando == b'PART':
        processar_part(conexao, partes)


def dados_recebidos(conexao, dados):
    if dados == b'':
        return sair(conexao)

    conexao.buffer += dados

    while b'\r\n' in conexao.buffer:
        mensagem, conexao.buffer = conexao.buffer.split(b'\r\n', 1)
        processar_mensagem(conexao, mensagem)


def conexao_aceita(conexao):
    print(conexao, 'nova conexão')

    # Note que, no Python, atributos NÃO precisam ser previamente declarados na classe!
    # Se precisar, esta função é o melhor local para adicionar novos atributos ao objeto conexao.
    #
    # Por exemplo, para armazenar o nick do usuário:
    conexao.nick = b'*'
    conexao.buffer = b''
    conexao.canais = set()

    # Fique à vontade para adicionar mais atributos, se necessário.
    conexao.registrar_recebedor(dados_recebidos)

servidor = Servidor(6667)
servidor.registrar_monitor_de_conexoes_aceitas(conexao_aceita)
asyncio.get_event_loop().run_forever()